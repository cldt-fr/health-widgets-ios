# Everything is optional: the server works without a .env file.
# Copy this file to .env to change a value, then `docker compose up -d`.

# Port published on your machine.
HW_PORT=8000

# Code the app asks for when you connect it to this server. When empty, one is
# generated on first start and printed in the logs:
#   docker compose logs api | grep "Signup code"
HW_SIGNUP_CODE=

# Key that encrypts Garmin tokens at rest. When empty, one is generated on first start
# and kept in the data volume. To set your own: openssl rand 32 | base64 | tr '+/' '-_'
HW_ENCRYPTION_KEY=

# Synthetic "demo" provider, handy to try the app without a watch.
HW_ENABLE_DEMO_PROVIDER=false

# App Store review account: signing in to Garmin with exactly these credentials shows
# sample data instead of a real account. Leave empty to disable.
HW_REVIEW_EMAIL=
HW_REVIEW_PASSWORD=

# Shown on the privacy policy page (/privacy): who runs this server, a contact email,
# and the hosting provider (for example "OVHcloud, en France").
HW_PRIVACY_OPERATOR=
HW_PRIVACY_CONTACT=
HW_PRIVACY_HOSTING=

HW_LOG_LEVEL=INFO
