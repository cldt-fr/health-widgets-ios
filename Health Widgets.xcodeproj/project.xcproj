        { "path": "<PRODUCTS>/Widgets.appex", "id": "E6742689309728B900CB8449", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Health Widgets/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
